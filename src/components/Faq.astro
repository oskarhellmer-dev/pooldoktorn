---
interface Props { faq: { q: string; a: string }[] }
const { faq } = Astro.props;
---
{faq?.length > 0 && (
  <section class="faq" aria-labelledby="vanliga-fragor">
    <h2 id="vanliga-fragor">Vanliga frågor</h2>
    <dl class="faqgrid">
      {faq.map(({ q, a }) => (
        <div class="item">
          <dt>{q}</dt>
          <dd set:html={a} />
        </div>
      ))}
    </dl>
  </section>
)}
