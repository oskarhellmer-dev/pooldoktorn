---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  ogType?: string;
  jsonLd?: string;
  noindex?: boolean;
}
const { title, description, path, ogImage, ogType, jsonLd, noindex } = Astro.props;
---
<!doctype html>
<html lang="sv">
  <head>
    <Seo {title} {description} {path} {ogImage} {ogType} {jsonLd} {noindex} />
  </head>
  <body>
    <a class="skip" href="#main">Hoppa till innehåll</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
