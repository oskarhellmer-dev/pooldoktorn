---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Newsletter from '../components/Newsletter.astro';
import { schemaGraph, breadcrumbs, webPage } from '../lib/schema';
import { u, abs } from '../lib/urls';

const title = 'Poolkalkylatorn — volym och dosering för din pool';
const desc = 'Räkna ut din pools vattenvolym och få uppskattad dos av chockklor och pH-minus. Gratis verktyg för svenska poolägare.';
const path = '/kalkylator/';
const jsonLd = schemaGraph([
  {
    '@type': 'WebApplication',
    name: 'Poolkalkylatorn',
    url: abs(path),
    inLanguage: 'sv-SE',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'All',
    description: desc,
  },
  webPage(title, desc, path),
  breadcrumbs([{ name: 'Hem', path: '/' }, { name: 'Kalkylator', path }]),
]);
---
<Base title={title} description={desc} path={path} jsonLd={jsonLd}>
  <div class="wrap">
    <Breadcrumbs trail={[{ name: 'Hem', path: '/' }, { name: 'Kalkylator' }]} />
    <article class="article">
      <h1>Poolkalkylatorn</h1>
      <p class="lead">Ange din pools mått och nuvarande pH. Verktyget räknar ut vattenvolym och ger ett uppskattat startvärde för chockklor och pH-minus.</p>
      <div class="tool">
        <div class="row"><label for="form">Poolform</label>
          <select id="form"><option value="rect">Rektangulär</option><option value="round">Rund/oval</option></select></div>
        <div class="row" id="r-len"><label for="len">Längd (m)</label><input id="len" type="number" value="8" step="0.1" min="1" /></div>
        <div class="row" id="r-wid"><label for="wid">Bredd (m)</label><input id="wid" type="number" value="4" step="0.1" min="1" /></div>
        <div class="row" id="r-dia" style="display:none"><label for="dia">Diameter (m)</label><input id="dia" type="number" value="4" step="0.1" min="1" /></div>
        <div class="row"><label for="dep">Medeldjup (m)</label><input id="dep" type="number" value="1.5" step="0.1" min="0.3" /></div>
        <div class="row"><label for="ph">Aktuellt pH</label><input id="ph" type="number" value="7.8" step="0.1" min="6" max="9" /></div>
        <div class="out" id="out"></div>
      </div>
      <div class="note">Siffrorna är uppskattningar för att komma igång. Följ alltid doseringen på din produkt och mät vattnet mellan varje justering. Blanda aldrig kemikalier med varandra.</div>

      <h2 id="sa-raknar-du">Så räknar du ut din poolvolym</h2>
      <p>All dosering av poolkemikalier utgår från vattenvolymen, och volymen räknas i kubikmeter (m³) — där 1 m³ motsvarar 1 000 liter. Har du volymen rätt blir doseringen rätt; har du den fel kan du både överdosera och underdosera.</p>
      <ul>
        <li><strong>Rektangulär pool:</strong> längd × bredd × medeldjup. En pool på 8 × 4 m med 1,5 m djup ger 8 × 4 × 1,5 = 48 m³, alltså 48 000 liter.</li>
        <li><strong>Rund pool:</strong> diameter × diameter × 0,785 × medeldjup. En rund pool med 4 m diameter och 1,2 m djup ger 4 × 4 × 0,785 × 1,2 ≈ 15 m³.</li>
        <li><strong>Oval pool:</strong> mät som en rektangel och dra av för de rundade hörnen — eller använd längd × bredd × medeldjup och justera ned med 10–15 %.</li>
      </ul>
      <p><strong>Medeldjup</strong> får du genom att lägga ihop djupet vid den grunda och den djupa änden och dela med två. Har din pool en separat djupdel eller trappa, mät upp den ungefärliga fördelningen och uppskatta därefter.</p>

      <h2 id="sa-laser-du-resultatet">Så tolkar du resultatet</h2>
      <p>Verktyget visar volymen och ger ett <em>startvärde</em> — inte en exakt doseringsinstruktion. Använd siffrorna som en riktlinje:</p>
      <ul>
        <li><strong>Chockklor</strong> används vid grönt eller grumligt vatten och vid uppstart. Sikta på 5–10 mg/l fritt klor, vänta 8–12 timmar och mät igen innan du justerar vidare.</li>
        <li><strong>pH-minus</strong> sänker ett för högt pH. Justera i steg, cirkulera i minst 2–4 timmar och mät om — sikta på pH 7,2–7,4.</li>
        <li><strong>pH-plus</strong> höjer ett för lågt pH på samma sätt: små steg, god cirkulation, ny mätning.</li>
      </ul>

      <h2 id="sakerhet">Säkerhet vid dosering</h2>
      <p>Tillsätt alltid kemikalier i vattnet — aldrig vatten i kemikalien. Blanda aldrig klor och pH-justerare direkt med varandra, och häll aldrig i två produkter samtidigt. Använd handskar och ögonskydd, dosera med pumpen igång och med god ventilation. Vid osäkerhet: mindre mängd, längre cirkulation och mät igen.</p>

      <p>Behöver du bakgrunden? Läs <a href={u('/guider/ph-och-klor/')}>pH och klor — rätt nivåer</a> eller <a href={u('/guider/gront-poolvatten/')}>guiden om grönt poolvatten</a>. Vill du följa värdena över tid i stället för att räkna varje gång, använd <a href={u('/pooljournal/')}>pooljournalen</a>.</p>
      <Newsletter />
    </article>
  </div>
  <script>
    function calc() {
      const form = document.getElementById('form') as HTMLSelectElement;
      const val = (id: string) => Number((document.getElementById(id) as HTMLInputElement).value);
      let vol: number;
      if (form.value === 'round') vol = Math.PI * Math.pow(val('dia') / 2, 2) * val('dep');
      else vol = val('len') * val('wid') * val('dep');
      vol = Math.round(vol * 10) / 10;
      const ph = val('ph');
      let pm = '';
      if (ph > 7.6) pm = `${Math.round(vol * 10)}–${Math.round(vol * 15)} g pH-minus (sänk mot 7,2–7,4)`;
      else if (ph < 7.2) pm = `${Math.round(vol * 10)}–${Math.round(vol * 15)} g pH-plus`;
      else pm = 'pH ligger i intervallet — ingen justering behövs.';
      const out = document.getElementById('out')!;
      out.innerHTML =
        `<p><b>Vattenvolym:</b> cirka ${vol} m³</p>` +
        `<p><b>Chockklor vid grönt/start:</b> cirka ${Math.round(vol * 15)} g snabbklor (sikta på 5–10 mg/l fritt klor).</p>` +
        `<p><b>pH-justering:</b> ${pm}</p>`;
    }
    const ids = ['form', 'len', 'wid', 'dia', 'dep', 'ph'];
    ids.forEach((id) => {
      document.getElementById(id)?.addEventListener('input', () => {
        const round = (document.getElementById('form') as HTMLSelectElement).value === 'round';
        (document.getElementById('r-len') as HTMLElement).style.display = round ? 'none' : 'flex';
        (document.getElementById('r-wid') as HTMLElement).style.display = round ? 'none' : 'flex';
        (document.getElementById('r-dia') as HTMLElement).style.display = round ? 'flex' : 'none';
        calc();
      });
    });
    calc();
  </script>
</Base>
