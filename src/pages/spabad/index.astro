---
import { spa as items } from '../../data/content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AffiliateBox from '../../components/AffiliateBox.astro';
import { collectionPage, breadcrumbs, faqPage, schemaGraph } from '../../lib/schema';
import { u } from '../../lib/urls';

const path = '/spabad/';
const title = 'Spabad – guider för köp, installation och skötsel';
const desc = 'Allt om spabad: planera köpet, förbered platsen, installera säkert och håll vattnet i balans. Oberoende guider för dig som har eller ska köpa spabad.';
const faq = [
  { q: 'Vad ska pH-värdet vara i ett spabad?', a: 'Sikta på pH 7,2–7,6, helst nära 7,2 där klorets effekt är som bäst. Läs mer i <a href="/spabad/spabad-vattenbalans/">vattenbalans för spabad</a>.' },
  { q: 'Kan man ha spabad ute på vintern?', a: 'Ja, ett korrekt installerat och isolerat spabad är byggt för året-runt-drift. Undvik att tömma och stänga av det – frysskador täcks inte av garantin. Se <a href="/spabad/spabad-vinter/">spabad vintertid</a>.' },
  { q: 'Vad kostar det att driva ett spabad?', a: 'Driftkostnaden styrs nästan helt av isolering, termolock och badvanor. Så räknar du på förbrukningen i <a href="/spabad/spabad-energiforbrukning/">guiden om energiförbrukning</a>.' },
];
const jsonLd = schemaGraph([
  collectionPage(title, desc, path, items.map((i) => ({ name: i.h1, url: `${path}${i.slug}/` }))),
  breadcrumbs([{ name: 'Hem', path: '/' }, { name: 'Spabad', path }]),
  faqPage(faq),
]);
---
<Base title={title} description={desc} path={path} jsonLd={jsonLd} ogImage="/bilder/spabad-komplett-guide-1200.webp">
  <div class="wrap">
    <Breadcrumbs trail={[{ name: 'Hem', path: '/' }, { name: 'Spabad' }]} />
    <section class="sec">
      <h1 class="hub-h1">Spabad &amp; badtunna</h1>
      <p class="sub">Vad letar du efter? Välj spår — badtunna eller spabad.</p>
      <div class="valkort-grid">
        <a class="valkort valkort--accent" href={u('/spabad/badtunna/')}>
          <img src={u('/bilder/badtunna-800.webp')} srcset={`${u('/bilder/badtunna-400.webp')} 400w, ${u('/bilder/badtunna-800.webp')} 800w`} sizes="(max-width:720px) 100vw, 50vw" width="1200" height="675" loading="eager" alt="Badtunna – ved eller el" />
          <div class="valkort-body">
            <span class="tag">Köpguide</span>
            <h3>Badtunnor — ved &amp; el</h3>
            <p>Så väljer du rätt tunna, vad den kostar och hur du bygger in den. Se även modeller hos TimberIN (4 % rabatt).</p>
          </div>
        </a>
        <a class="valkort" href={u('/spabad/spabad-komplett-guide/')}>
          <img src={u('/bilder/spabad-komplett-guide-800.webp')} srcset={`${u('/bilder/spabad-komplett-guide-400.webp')} 400w, ${u('/bilder/spabad-komplett-guide-800.webp')} 800w`} sizes="(max-width:720px) 100vw, 50vw" width="1200" height="675" loading="eager" alt="Spabad – komplett guide" />
          <div class="valkort-body">
            <span class="tag">Guide</span>
            <h3>Spabad — köp &amp; skötsel</h3>
            <p>Driftkostnad, vattenvård, vinter och installation. Allt du behöver för ett spabad som håller året runt.</p>
          </div>
        </a>
      </div>
      <div class="prose hub-lead">
        <p>Ett spabad är inte en liten pool. Det är en egen apparat med egen kemi, egen el och en egen dygnsrytm som ska skötas året runt. Det mesta som går fel – irriterande vatten, flödesfel eller en onödigt hög elkostnad – beror på några få beslut och vanor. Här har vi samlat guiderna som gör dem enkla.</p>
        <p>Fundera du på att köpa spabad eller badtunna? Börja med <a href={u('/spabad/spabad-eller-badtunna/')}>spabad eller badtunna</a> och vår <a href={u('/kopguider/spabad-kopguide/')}>spabad-köpguide</a>. Har du landat i tunna finns <a href={u('/spabad/badtunna/')}>badtunna – så väljer du rätt</a>. Har du redan ett bad hittar du skötseln under <a href={u('/spabad/skotsel-av-spabad/')}>skötsel</a> och <a href={u('/spabad/spabad-vattenbalans/')}>vattenbalans</a>.</p>
        <p>Precis som i resten av sajten är vi oberoende och utan säljsnack. Vi säljer inga spabad själva – vi skriver om vad som faktiskt spelar roll. Med rätt vattenvård mår badet bra, och det är ingen konst: det handlar om en fast rutin.</p>
      </div>
      <div class="grid">
        {items.map((p) => (
          <a class="card" href={u(`/spabad/${p.slug}/`)}>
            <img class="thumb" src={u(`/bilder/${p.img}-800.webp`)}
              srcset={`${u(`/bilder/${p.img}-400.webp`)} 400w, ${u(`/bilder/${p.img}-800.webp`)} 800w`}
              sizes="(max-width:860px) 100vw, 360px" width="1200" height="675" loading="lazy" alt={p.h1} />
            <div class="body">
              <span class="tag">{p.tag}</span>
              <h3>{p.h1}</h3>
              <p>{p.lead.slice(0, 110)}…</p>
            </div>
          </a>
        ))}
      </div>
    </section>
    <div class="article hub-article">
      <h2>Vanliga frågor om spabad</h2>
      <dl class="faqgrid">
        {faq.map((f) => (
          <div class="item">
            <dt>{f.q}</dt>
            <dd set:html={f.a} />
          </div>
        ))}
      </dl>
    </div>
    <AffiliateBox aff={{
      title: 'Badtunna eller bastu i stället?',
      text: 'TimberIN tillverkar badtunnor, utomhusbastur och isbad i Sverige. Som läsare hos Pooldoktorn får du 4 % rabatt med koden nedan.',
      cta: 'Se badtunnor hos Badtunnaspa',
      url: 'https://www.badtunnaspa.se/?ref=pooldoktorn',
      code: 'POOLDOKTORN',
    }} />
  </div>
</Base>
