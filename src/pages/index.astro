---
import { guider, kopguider, bygge, spa, bySlug, href } from '../data/content';
import Base from '../layouts/Base.astro';
import { SITE } from '../consts';
import RedakChoice from '../components/RedakChoice.astro';
import { website, webPage, breadcrumbs, faqPage, schemaGraph } from '../lib/schema';
import { u } from '../lib/urls';

const title = `${SITE.name} — skötsel och köpguider för din pool`;
const faq = [
  { q: 'Vad ska pH-värdet vara i en pool?', a: 'Sikta på pH 7,2–7,6, helst nära 7,2 där klorets effekt är som bäst. Läs mer i <a href="/guider/ph-och-klor/">guiden om pH och klor</a>.' },
  { q: 'Hur mycket klor ska poolen ha?', a: 'Fritt klor bör ligga på 1–3 mg/l i normal drift. Vid grönt eller grumligt vatten chockklorerar du upp mot 5–10 mg/l och låter värdet sjunka igen.' },
  { q: 'Varför är poolvattnet grönt?', a: 'Grönt vatten är alger. Orsaken är oftast för lite fritt klor eller fel pH. Sänk pH, <a href="/guider/chockklorering/">chockklorera</a> och kör cirkulationen dygnet runt.' },
  { q: 'Hur ofta behöver jag sköta poolen?', a: 'En enkel veckorutin räcker: mät vatten, rengör korgarna, sug botten och backspola vid behov. Logga gärna värdena i <a href="/pooljournal/">pooljournalen</a>.' },
  { q: 'Säljer Pooldoktorn poolprodukter?', a: 'Nej. Vi är en oberoende kunskapssajt och säljer inget själva. Vissa länkar är affiliatelänkar – handlar du via dem får vi en liten provision utan att priset ändras för dig.' },
];
const jsonLd = schemaGraph([
  website(),
  webPage(title, SITE.description, '/'),
  breadcrumbs([{ name: 'Hem', path: '/' }]),
  faqPage(faq),
]);

// Vinterläge – korten högst upp möter besökaren i november
const vinter = [
  { slug: 'badtunna', title: 'Bästa badtunnan 2026 – vedeldad, el eller plastinsats?' },
  { slug: 'spabad-energiforbrukning', title: 'Vad kostar spabadet på vintern?' },
  { slug: 'vinterstangning-pool', title: 'Vinterstäng poolen steg för steg' },
].map((x) => ({ ...x, page: bySlug(x.slug) })).filter((x) => x.page);

// Spabad-sektionens kort – badtunna + energiförbrukning ligger redan under "Just nu – vinter", så de undviks här (ingen deja vu)
const spaOrder = ['spabad-vinter', 'skotsel-av-spabad', 'spabad-vattenbalans', 'spabad-komplett-guide', 'installera-spabad-markarbete', 'vattenbyte-spabad'];
const spaTop = spaOrder.map((s) => bySlug(s)).filter(Boolean);

// Populära guider – vinterstängning först, vårstart/grönt vatten medvetet längre ner
const popOrder = ['vinterstangning-pool', 'ph-och-klor', 'chockklorering', 'grumligt-poolvatten', 'poolfilter-guide', 'poolvard-vecka'];
const popular = popOrder.map((s) => bySlug(s)).filter(Boolean);
---
<Base title={title} description={SITE.description} path="/" jsonLd={jsonLd} ogImage="/bilder/hero.jpg">
  <section class="hero">
    <img class="heroimg" src={u('/bilder/hero-1200.webp')} srcset={`${u('/bilder/hero-400.webp')} 400w, ${u('/bilder/hero-800.webp')} 800w, ${u('/bilder/hero-1200.webp')} 1200w`} sizes="100vw" alt="" width="1200" height="675" loading="eager" fetchpriority="high" aria-hidden="true" />
    <div class="wrap">
      <h1>Pool och spabad — rätt skött, hela året</h1>
      <p>Det är vinter: dags att stänga poolen rätt, hålla koll på elkostnaden och planera badtunnan. Oberoende guider för dig med pool eller spa — vi säljer inget själva, vi visar bara vad som funkar.</p>
      <a class="cta" href={u('/spabad/badtunna/')}>Bästa badtunnan 2026</a>
      <a class="cta" href={u('/guider/vinterstangning-pool/')}>Vinterstäng poolen</a>
    </div>
  </section>
  <div class="disc"><div class="wrap">{SITE.affiliateDisclosure}</div></div>

  <div class="wrap">
    <section class="sec">
      <RedakChoice
        img="badtunna"
        kicker="Redaktionens val"
        title="Isolerad vedeldad badtunna med plastinsats"
        usps={[
          'Byggd för nordiskt vinterklimat — vedeldad eller eluppvärmd',
          'Leveransklart och byggt för året-runt-drift — 0 kr i standby-el för vedmodellen',
          '4 % läsarrabatt med koden nedan – spara ca 1 500–2 500 kr',
        ]}
        code="POOLDOKTORN"
        cta="Se pris & modeller hos TimberIN"
        url="https://www.badtunnaspa.se/badtunnor/?ref=pooldoktorn"
      />
    </section>

    <section class="sec">
      <h2>Just nu – vinter</h2>
      <div class="sub">Det du behöver göra innan frosten och det du planerar inför nästa säsong</div>
      <div class="grid">
        {vinter.map(({ page, title: t }, i) => (
          <a class="card" href={href(page.slug)}>
            <img class="thumb" src={u(`/bilder/${page.img}-800.webp`)}
              srcset={`${u(`/bilder/${page.img}-400.webp`)} 400w, ${u(`/bilder/${page.img}-800.webp`)} 800w`}
              sizes="(max-width:860px) 100vw, 360px" width="1200" height="675" loading="lazy" alt={t} />
            <div class="body">
              <span class="tag">{i === 0 ? 'Badtunna' : page.tag}</span>
              <h3>{t}</h3>
              <p>{page.lead.slice(0, 110)}…</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="sec">
      <h2>Spabad &amp; badtunna</h2>
      <div class="sub">Köp, installera och sköt ditt spabad eller din badtunna – året runt</div>
      <a class="valkort valkort--accent valkort--wide" href={u('/spabad/spabad-eller-badtunna/')}>
        <img src={u('/bilder/spabad-eller-badtunna-800.webp')} srcset={`${u('/bilder/spabad-eller-badtunna-400.webp')} 400w, ${u('/bilder/spabad-eller-badtunna-800.webp')} 800w`} sizes="(max-width:720px) 100vw, 1100px" width="1200" height="675" loading="lazy" alt="Spabad eller badtunna – så väljer du" />
        <div class="valkort-body">
          <span class="tag">Jämförelse</span>
          <h3>Spabad eller badtunna — så väljer du</h3>
          <p>Den ena är en apparat med cirkulation och kemi, den andra en enklare tunna med manuell vattenvård. Så avgör du vilken som passar dig — och vad du ska titta efter.</p>
        </div>
      </a>
      <div class="grid">
        {spaTop.map((p) => (
          <a class="card" href={u(`/spabad/${p.slug}/`)}>
            <img class="thumb" src={u(`/bilder/${p.img}-800.webp`)}
              srcset={`${u(`/bilder/${p.img}-400.webp`)} 400w, ${u(`/bilder/${p.img}-800.webp`)} 800w`}
              sizes="(max-width:860px) 100vw, 360px" width="1200" height="675" loading="lazy" alt={p.h1} />
            <div class="body">
              <span class="tag">{p.tag}</span>
              <h3>{p.h1}</h3>
              <p>{p.lead.slice(0, 110)}…</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="sec">
      <h2>Populära guider</h2>
      <div class="sub">Det folk faktiskt söker hjälp med</div>
      <div class="grid">
        {popular.map((p) => (
          <a class="card" href={u(`/guider/${p.slug}/`)}>
            <img class="thumb" src={u(`/bilder/${p.img}-800.webp`)}
              srcset={`${u(`/bilder/${p.img}-400.webp`)} 400w, ${u(`/bilder/${p.img}-800.webp`)} 800w`}
              sizes="(max-width:860px) 100vw, 360px" width="1200" height="675" loading="lazy" alt={p.h1} />
            <div class="body">
              <span class="tag">{p.tag}</span>
              <h3>{p.h1}</h3>
              <p>{p.lead.slice(0, 110)}…</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="sec">
      <h2>Köpguider</h2>
      <div class="sub">Utrustning som passar din pool — utan säljsnack</div>
      <div class="grid">
        {kopguider.map((p) => (
          <a class="card" href={u(`/kopguider/${p.slug}/`)}>
            <img class="thumb" src={u(`/bilder/${p.img}-800.webp`)}
              srcset={`${u(`/bilder/${p.img}-400.webp`)} 400w, ${u(`/bilder/${p.img}-800.webp`)} 800w`}
              sizes="(max-width:860px) 100vw, 360px" width="1200" height="675" loading="lazy" alt={p.h1} />
            <div class="body">
              <span class="tag">{p.tag}</span>
              <h3>{p.h1}</h3>
              <p>{p.lead.slice(0, 110)}…</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="sec">
      <h2>Poolbygge</h2>
      <div class="sub">Planera, bygg och äg din pool — från första skiss till vardag</div>
      <div class="grid">
        {bygge.slice(0, 6).map((p) => (
          <a class="card" href={u(`/poolbygge/${p.slug}/`)}>
            <img class="thumb" src={u(`/bilder/${p.img}-800.webp`)}
              srcset={`${u(`/bilder/${p.img}-400.webp`)} 400w, ${u(`/bilder/${p.img}-800.webp`)} 800w`}
              sizes="(max-width:860px) 100vw, 360px" width="1200" height="675" loading="lazy" alt={p.h1} />
            <div class="body">
              <span class="tag">{p.tag}</span>
              <h3>{p.h1}</h3>
              <p>{p.lead.slice(0, 110)}…</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="sec">
      <h2>Verktyg</h2>
      <div class="sub">Gratis — räkna ut vad din pool behöver och följ värdena över tid</div>
      <div class="grid">
        <a class="card" href={u('/kalkylator/')}>
          <img class="thumb" src={u('/bilder/hero-800.webp')}
            srcset={`${u('/bilder/hero-400.webp')} 400w, ${u('/bilder/hero-800.webp')} 800w, ${u('/bilder/hero-1200.webp')} 1200w`}
            sizes="(max-width:860px) 100vw, 360px" width="1200" height="675" loading="lazy" alt="Poolkalkylatorn" />
          <div class="body">
            <span class="tag">Verktyg</span>
            <h3>Poolkalkylatorn — hur mycket klor och pH-minus behöver din pool?</h3>
            <p>Ange volym och aktuella värden och få doseringsförslag direkt.</p>
          </div>
        </a>
        <a class="card" href={u('/pooljournal/')}>
          <img class="thumb" src={u('/bilder/poolvard-vecka-800.webp')}
            srcset={`${u('/bilder/poolvard-vecka-400.webp')} 400w, ${u('/bilder/poolvard-vecka-800.webp')} 800w, ${u('/bilder/poolvard-vecka-1200.webp')} 1200w`}
            sizes="(max-width:860px) 100vw, 360px" width="1200" height="675" loading="lazy" alt="Pooljournal" />
          <div class="body">
            <span class="tag">Verktyg</span>
            <h3>Pooljournal — logga pH, klor och vattenvärden</h3>
            <p>Få direkt återkoppling mot riktvärdena och följ utvecklingen över säsongen.</p>
          </div>
        </a>
        <div class="news">
          <h3>Poolbrevet</h3>
          <p>Säsongstips och påminnelser — rakt i inkorgen, bara när det är relevant.</p>
          <form class="js-news" novalidate>
            <input type="email" name="email" placeholder="din@epost.se" aria-label="E-post" required autocomplete="email" />
            <button type="submit">Prenumerera</button>
          </form>
          <p class="msg" role="status" aria-live="polite" data-msg></p>
        </div>
      </div>
    </section>

    <section class="sec">
      <h2>Vanliga frågor</h2>
      <div class="sub">Snabba svar på det poolägare oftast undrar</div>
      <div class="faq">
        <dl class="faqgrid">
          {faq.map((f) => (
            <div class="item">
              <dt>{f.q}</dt>
              <dd set:html={f.a} />
            </div>
          ))}
        </dl>
      </div>
    </section>
  </div>
</Base>
